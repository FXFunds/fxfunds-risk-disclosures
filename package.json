{
  "name": "@fxfunds/risk-disclosures",
  "version": "2.0.0",
  "description": "FXFunds Risk Disclosure Bot — risk percentage for a trade or USDT transfer at the moment it is checked, with a risk FAQ database searchable by keyword.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fxfunds-risk": "dist/index.js"
  },
  "files": [
    "dist",
    "fxfunds_risk_disclosures/*.json",
    "README.md",
    "LICENSE",
    "LICENSE-CONTENT"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node dist/index.js trade --asset crypto --leverage 20 --margin 10 && node dist/index.js transfer --network ERC20 --expected TRC20"
  },
  "keywords": [
    "fxfunds",
    "risk-percentage",
    "risk-score",
    "trading-risk",
    "leverage",
    "forex",
    "cryptocurrency",
    "stablecoin",
    "usdt",
    "faq"
  ],
  "homepage": "https://fxfunds.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FXFunds/fxfunds-risk-disclosures.git"
  },
  "bugs": {
    "url": "https://github.com/FXFunds/fxfunds-risk-disclosures/issues"
  },
  "author": "FXFunds (https://fxfunds.com/)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
